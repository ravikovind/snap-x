{
  "name": "@snap-x/core",
  "version": "0.3.0",
  "description": "Satori-based social image pack generator — OG, cover, thumbnail, poster, readme-card. No browser required.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "snap-x": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "default-designs/"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./render": "./src/render.mjs",
    "./check": "./src/check.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "satori": "^0.33.5"
  },
  "keywords": ["og-images", "satori", "social-cards", "snap-x", "claude-skill", "mcp"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
