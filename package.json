{
  "name": "snap-x-monorepo",
  "version": "0.1.0",
  "description": "Turn any project into a full image pack — OG cards, thumbnails, covers, posters. One command.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "examples": "node packages/core/src/cli.mjs render examples/snap-x/designs --out examples/snap-x",
    "examples:check": "node packages/core/src/cli.mjs check examples/snap-x/designs"
  },
  "keywords": [
    "og-images",
    "social-images",
    "satori",
    "claude-skill",
    "mcp"
  ],
  "author": "Ravi Kovind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravikovind/snap-x.git"
  }
}
