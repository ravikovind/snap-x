{
  "name": "snap-x-monorepo",
  "version": "0.1.0",
  "description": "Branded graphics for every platform, made by your AI agent. Exact sizes, real logos, safe zones checked. Claude Code plugin, MCP server and CLI.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "examples": "node scripts/examples.mjs render",
    "examples:check": "node scripts/examples.mjs check"
  },
  "keywords": [
    "branded-graphics",
    "social-images",
    "og-image",
    "youtube-thumbnail",
    "linkedin-banner",
    "app-store-screenshots",
    "play-store",
    "marketing-banners",
    "instagram",
    "claude-code",
    "claude-skill",
    "mcp",
    "mcp-server",
    "satori",
    "image-generation"
  ],
  "author": "Ravi Kovind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravikovind/snap-x.git"
  }
}
